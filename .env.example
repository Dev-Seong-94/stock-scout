# Copy this file to backend/.env and fill in the values. Never commit .env.

# FRED (free): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SEC asks every client to identify itself: "Your Name your@email.com"
SEC_USER_AGENT=

# Optional. Earnings calendar for the macro page (free plan): https://finnhub.io/register
FINNHUB_API_KEY=

# Frontend origin allowed to call the API
CORS_ORIGINS=http://localhost:3000
